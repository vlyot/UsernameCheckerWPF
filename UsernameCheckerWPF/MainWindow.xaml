<Window x:Class="UsernameCheckerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Username Checker" Height="450" Width="600">

    <Grid>
        <StackPanel Margin="10">
            <Button Content="Select File" Click="SelectFile_Click" Padding="5"/>
            <TextBlock Name="SelectedFileText" Text="No file selected" Margin="5"/>

            <Button x:Name="CheckUsernames" Content="Check Usernames" Click="CheckUsernames_Click" Padding="5" IsEnabled="False"/>

            <ProgressBar Name="ProgressBar" Height="10" Visibility="Hidden"/>

            <ListBox Name="ResultsList" Height="200" Margin="5"/>
            <Button x:Name="SaveResults" Content="Save Results" Click="SaveResults_Click" Padding="5" IsEnabled="False"/>

        </StackPanel>
    </Grid>
</Window>
